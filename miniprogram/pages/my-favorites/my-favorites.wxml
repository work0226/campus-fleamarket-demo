<view class="container">
  <scroll-view scroll-y class="list-wrap" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="load">
    <view wx:for="{{list}}" wx:key="_id" class="fav-card" bindtap="goDetail" data-item="{{item}}">
      <image wx:if="{{item.type==='item' && item.target.images && item.target.images.length}}" class="thumb" src="{{item.target.images[0]}}" mode="aspectFill" />
      <view wx:else class="thumb thumb-empty">{{item.type==='item'?'无图':'求购'}}</view>
      <view class="info">
        <view class="title">{{item.target.title}}</view>
        <view wx:if="{{item.type==='item'}}" class="price">¥{{item.target.price}}</view>
        <view wx:else class="price">预算 ¥{{item.target.budget}}</view>
        <view class="sub">
          <text class="tag">{{item.type==='item'?'闲置':'求购'}}</text>
          <text class="time">{{timeAgo(item.createTime)}}</text>
        </view>
      </view>
      <text class="del" catchtap="remove" data-id="{{item._id}}" data-index="{{index}}">×</text>
    </view>

    <view wx:if="{{loading}}" class="page-loading">加载中...</view>
    <view wx:if="{{!loading && !list.length && !error}}" class="empty">暂无收藏</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
  </scroll-view>
</view>
