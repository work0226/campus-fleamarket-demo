<view class="container" wx:if="{{want}}">
  <view class="want-card card">
    <view class="want-title">{{want.title}}</view>
    <view class="budget-row">
      <text class="budget">预算 ¥{{want.budget}}</text>
      <text class="tag">{{want.condition}}</text>
      <text class="tag">{{want.category}}</text>
    </view>
    <view wx:if="{{want.note}}" class="note">{{want.note}}</view>
    <view class="meta">
      <text>{{want.campus}}</text>
      <text class="time">{{timeAgo(want.createTime)}}</text>
    </view>
  </view>

  <view class="user-card card">
    <image wx:if="{{want.userAvatar}}" class="avatar" src="{{want.userAvatar}}" />
    <view wx:else class="avatar avatar-empty"></view>
    <view class="user-info">
      <text class="nickname">{{want.userNickName || '校园用户'}}</text>
      <text class="sub">发布者</text>
    </view>
    <text wx:if="{{isOwner}}" class="owner-tag">我的</text>
  </view>

  <view class="action-bar">
    <button class="btn-primary contact-btn {{isOwner?'disabled':''}}" disabled="{{isOwner}}" bindtap="contactOwner">
      {{isOwner?'这是你的求购':'我有这个，联系 TA'}}
    </button>
  </view>
</view>

<view wx:if="{{loading}}" class="page-loading">加载中...</view>
<view wx:if="{{error}}" class="error">{{error}}</view>
