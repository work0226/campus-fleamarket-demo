.want-card .want-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.want-card .budget-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.want-card .budget {
  color: var(--danger);
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.want-card .note {
  font-size: 28rpx;
  color: var(--text);
  background: #f9fafb;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.want-card .meta {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.user-card {
  display: flex;
  align-items: center;
}

.user-card .avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--border);
}

.user-card .user-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.user-card .nickname {
  font-size: 32rpx;
  font-weight: 500;
}

.user-card .sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.user-card .owner-tag {
  background: #eff6ff;
  color: var(--primary);
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 2rpx solid var(--border);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}

.contact-btn {
  width: 100%;
  margin: 0;
}

.contact-btn.disabled {
  opacity: 0.5;
}
