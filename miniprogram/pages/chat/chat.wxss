.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fa;
}

.target-bar {
  background: #fff;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  border-bottom: 2rpx solid var(--border);
}

.target-text {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  color: var(--text-secondary);
  font-size: 28rpx;
}

.message-list {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message.self {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--border);
  flex-shrink: 0;
}

.bubble {
  max-width: 60%;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
  margin: 0 16rpx;
}

.message.other .bubble {
  background: #fff;
  color: var(--text);
}

.message.self .bubble {
  background: var(--primary);
  color: #fff;
}

.read-status {
  font-size: 20rpx;
  color: var(--text-secondary);
  align-self: flex-end;
  margin-bottom: 8rpx;
}

.contact-toast {
  background: #fff7ed;
  color: var(--warning);
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  text-align: center;
}

.input-bar {
  background: #fff;
  padding: 16rpx 24rpx;
  border-top: 2rpx solid var(--border);
  display: flex;
  align-items: center;
}

.msg-input {
  flex: 1;
  background: #f3f4f6;
  border-radius: 36rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0 32rpx;
}

.send-btn[disabled] {
  opacity: 0.5;
}

.contact-bar {
  background: #fff;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--border);
  text-align: center;
}
