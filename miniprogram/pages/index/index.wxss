.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background: #f3f4f6;
  border-radius: 32rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 20rpx;
  color: var(--primary);
  font-size: 28rpx;
}

.filter-bar {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 24rpx;
}

.picker {
  font-size: 28rpx;
  color: var(--text);
  padding: 8rpx 16rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
}

.price-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
}

.price-bar input {
  width: 160rpx;
  height: 60rpx;
  background: #f3f4f6;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
}

.price-bar .split {
  margin: 0 16rpx;
  color: var(--text-secondary);
}

.price-bar .reset {
  margin-left: auto;
  color: var(--primary);
  font-size: 28rpx;
}

.list-wrap {
  height: calc(100vh - 320rpx);
}

.item-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.img-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f3f4f6;
}

.img-wrap image {
  width: 100%;
  height: 100%;
}

.img-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 24rpx;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-info .title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-info .price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.item-info .price {
  color: var(--danger);
  font-size: 34rpx;
  font-weight: 600;
}

.item-info .meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.item-info .meta .time {
  margin-left: auto;
}