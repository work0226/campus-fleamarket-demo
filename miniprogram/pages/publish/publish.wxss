.type-tabs {
  display: flex;
  border-radius: 16rpx;
  overflow: hidden;
  padding: 0;
}

.type-tabs .tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--text-secondary);
  background: #f9fafb;
}

.type-tabs .tab.active {
  color: #fff;
  background: var(--primary);
  font-weight: 500;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--border);
}

.form-row.block {
  flex-direction: column;
  align-items: flex-start;
}

.form-row .label {
  width: 160rpx;
  flex-shrink: 0;
  color: var(--text);
  font-size: 28rpx;
}

.form-row input,
.form-row textarea,
.form-row .picker-value {
  flex: 1;
  font-size: 28rpx;
}

.form-row textarea {
  width: 100%;
  height: 180rpx;
  background: #f9fafb;
  padding: 16rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
  margin-top: 12rpx;
}

.form-row .counter {
  align-self: flex-end;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.checkbox-group {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
}

.checkbox {
  padding: 8rpx 20rpx;
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  margin-right: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.checkbox.checked {
  border-color: var(--primary);
  color: var(--primary);
  background: #eff6ff;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.img-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.img-box image {
  width: 100%;
  height: 100%;
}

.img-box .del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  text-align: center;
  line-height: 36rpx;
  border-bottom-left-radius: 12rpx;
}

.add-img {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--border);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-secondary);
  font-size: 60rpx;
}

.submit-btn {
  margin-top: 40rpx;
}