.user-card {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  margin-right: 24rpx;
}

.avatar-large {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.user-meta {
  display: flex;
  flex-direction: column;
}

.user-meta .nickname {
  font-size: 38rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-meta .campus {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.stats {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-item .num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-item .label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.menu {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--border);
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item .arrow {
  color: var(--text-secondary);
}

.logout-btn {
  margin-top: 60rpx;
}
