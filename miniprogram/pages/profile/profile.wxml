<view class="container">
  <view class="user-card card">
    <view class="avatar-wrap" bindtap="chooseAvatar">
      <image wx:if="{{user.avatarUrl}}" class="avatar-large" src="{{user.avatarUrl}}" />
      <view wx:else class="avatar-large avatar-empty">点击上传</view>
    </view>
    <view class="user-meta">
      <text class="nickname">{{user.nickName || '校园用户'}}</text>
      <text class="campus">{{user.campus || '未选择校区'}}</text>
    </view>
  </view>

  <view class="stats card">
    <view class="stat-item" bindtap="goMyItems">
      <text class="num">{{stats.items}}</text>
      <text class="label">我的发布</text>
    </view>
    <view class="stat-item" bindtap="goMyFavorites">
      <text class="num">{{stats.favorites}}</text>
      <text class="label">我的收藏</text>
    </view>
    <view class="stat-item">
      <text class="num">{{credit.average || '—'}}</text>
      <text class="label">信用评分</text>
    </view>
  </view>

  <view class="menu card">
    <view class="menu-item" bindtap="goEditProfile">
      <text>编辑资料</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goMyItems">
      <text>我的发布</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goMyFavorites">
      <text>我的收藏</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goMessages">
      <text>消息列表</text>
      <text class="arrow">></text>
    </view>
  </view>

  <button class="btn-danger logout-btn" bindtap="logout">退出重登</button>
</view>
